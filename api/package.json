{
  "name": "@wehobby/api",
  "version": "0.1.0",
  "private": true,
  "description": "WeHobby REST API (Fastify).",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsc -b ../packages/shared/tsconfig.build.json && node --watch --env-file-if-exists=.env.local --import tsx src/server.ts",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@wehobby/shared": "^0.1.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  }
}
