# Copy to .env.local for local development. Placeholder values only.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_VERSION=local

# The PostGIS container from the root docker-compose.yml.
DATABASE_URL=postgres://wehobby:change-me-local-only@localhost:5432/wehobby
# Admin connection used by the database tests; each test file creates and
# drops its own database. Without it, those tests are skipped.
TEST_DATABASE_URL=postgres://wehobby:change-me-local-only@localhost:5432/postgres

# Entra External ID tenant and app registrations (portal guide, step 12).
AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
AUTH_TENANT_SUBDOMAIN=yourtenant
AUTH_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
AUTH_WEB_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional, comma separated list of allowed web origins. Not needed locally:
# the Vite dev server proxies /api to this API, so the browser sees one origin.
# CORS_ORIGIN=http://localhost:5173
