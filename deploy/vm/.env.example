# /opt/wehobby/.env on the VM (chmod 600). Never commit the real file.
# Placeholder values only. Everything that differs between VMs lives here.

# Image tag to run, from the images workflow: sha-<7 character commit sha>.
# The same tag runs on every VM.
IMAGE_TAG=sha-0000000

# Set once when the VM is first deployed. Keep the existing value, or the
# database will not start. Generate a new one with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# Names Caddy serves and gets certificates for, comma separated. Each must
# resolve to this VM. A www.<name> entry redirects to <name>.
#   Bicep VM:  wehobby.app, www.wehobby.app, iaas.wehobby.app, iaas-bicep.wehobby.app
#   Portal VM: retired and stopped since 22 Oct 2026 (DNS moved to the Bicep VM)
#   Local:     :80 (plain HTTP, no certificates)
SITE_ADDRESS=example.wehobby.app

# Entra External ID (step 12). These ids are not secrets, but keep them out of git.
AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
AUTH_TENANT_SUBDOMAIN=yourtenant
AUTH_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
AUTH_WEB_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional overrides, mostly for running this file locally:
# DATA_DIR=./.data
# IMAGE_PREFIX=ghcr.io/gdamascenomoreira
# LOG_LEVEL=info
